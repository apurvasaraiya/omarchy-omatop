class WebSocket:
    def __init__(self, url, timeout=4.0):
        u = urllib.parse.urlsplit(url)
        self.s = socket.create_connection((u.hostname, u.port), timeout=timeout)
        key = base64.b64encode(os.urandom(16)).decode()
        path = u.path or "/"
        req = ("GET %s HTTP/1.1\r\nHost: %s:%d\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
               "Sec-WebSocket-Key: %s\r\nSec-WebSocket-Version: 13\r\n\r\n") % (path, u.hostname, u.port, key)
        self.s.sendall(req.encode())
        buf = b""
        while b"\r\n\r\n" not in buf:
            chunk = self.s.recv(4096)
            if not chunk:
                raise ConnectionError("websocket handshake: connection closed")
            buf += chunk
        head, _, self.buf = buf.partition(b"\r\n\r\n")
        if b" 101 " not in head.split(b"\r\n")[0]:
            raise ConnectionError("websocket handshake refused: " + head.split(b"\r\n")[0].decode(errors="replace"))

    def close(self):
        try:
            self.s.close()
        except OSError:
            pass

    def send(self, text):
        data = text.encode()
        mask = os.urandom(4)
        n = len(data)
        hdr = bytearray([0x81])
        if n < 126:
            hdr.append(0x80 | n)
        elif n < 65536:
            hdr.append(0x80 | 126)
            hdr += struct.pack(">H", n)
        else:
            hdr.append(0x80 | 127)
            hdr += struct.pack(">Q", n)
        hdr += mask
        self.s.sendall(bytes(hdr) + bytes(b ^ mask[i & 3] for i, b in enumerate(data)))

    def _need(self, n):
        while len(self.buf) < n:
            chunk = self.s.recv(1 << 17)
            if not chunk:
                raise ConnectionError("websocket closed")
            self.buf += chunk

    def _frame(self):
        self._need(2)
        b0, b1 = self.buf[0], self.buf[1]
        fin = bool(b0 & 0x80)
        op = b0 & 0x0F
        n = b1 & 0x7F
        off = 2
        if n == 126:
            self._need(4)
            n = struct.unpack(">H", self.buf[2:4])[0]
            off = 4
        elif n == 127:
            self._need(10)
            n = struct.unpack(">Q", self.buf[2:10])[0]
            off = 10
        self._need(off + n)
        payload = self.buf[off:off + n]
        self.buf = self.buf[off + n:]
        return fin, op, payload

    def recv(self):
        parts = []
        while True:
            fin, op, payload = self._frame()
            if op == 8:
                raise ConnectionError("websocket closed by peer")
            if op == 9:  # ping -> pong
                self.s.sendall(bytes([0x8A, 0x80]) + os.urandom(4))
                continue
            if op == 10:
                continue
            parts.append(payload)
            if fin:
                return b"".join(parts).decode("utf-8", "replace")


class DevTools:
    """Tiny Chrome DevTools Protocol client over the browser endpoint."""

    def __init__(self, ws_url):
        self.ws = WebSocket(ws_url)
        self.next_id = 0
        self.pending_events = []

    def close(self):
        self.ws.close()

    def call(self, method, params=None, session=None, timeout=4.0):
        self.next_id += 1
        mid = self.next_id
        msg = {"id": mid, "method": method, "params": params or {}}
        if session:
            msg["sessionId"] = session
        self.ws.send(json.dumps(msg))
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            m = json.loads(self.ws.recv())
            if m.get("id") == mid:
                if "error" in m:
                    raise RuntimeError("%s: %s" % (method, m["error"].get("message", m["error"])))
                return m.get("result", {})
            self.pending_events.append(m)
        raise TimeoutError(method)

    def drain_until(self, event_name, timeout=4.0):
        """Yield queued + incoming events until event_name arrives."""
        deadline = time.monotonic() + timeout
        queued, self.pending_events = self.pending_events, []
        for m in queued:
            yield m
            if m.get("method") == event_name:
                return
        while time.monotonic() < deadline:
            m = json.loads(self.ws.recv())
            yield m
            if m.get("method") == event_name:
                return
        raise TimeoutError(event_name)


def devtools_port_file(profile_dir):
    return os.path.join(profile_dir, "DevToolsActivePort")


def read_devtools_endpoint(profile_dir):
    txt = read(devtools_port_file(profile_dir), 512)
    lines = txt.strip().splitlines()
    if len(lines) < 2 or not lines[0].isdigit():
        return None
    port = int(lines[0])
    if port <= 0:
        return None
    return "ws://127.0.0.1:%d%s" % (port, lines[1].strip())


def host_of(url):
    try:
        u = urllib.parse.urlsplit(url)
    except ValueError:
        return url
    if u.scheme in ("http", "https"):
        return (u.hostname or url).removeprefix("www.")
    if u.scheme == "chrome-extension":
        return "extension"
    if u.scheme in ("chrome", "devtools", "about"):
        return "Chromium pages"
    return u.scheme or url


class SiteResolver:
    """Keeps the target -> renderer-pid map for one browser profile.

    Resolving a target costs one attach plus a zero-length trace, about
    50 ms, so results are cached per target and only redone when the
    target navigates or its renderer disappears.
    """

    def __init__(self, profile_dir):
        self.profile_dir = profile_dir
        self.cache = {}  # targetId -> {"url", "title", "pids": [..]}
        self.status = "off"
        self.error = ""

    def sites(self, live_pids):
        endpoint = read_devtools_endpoint(self.profile_dir)
        if not endpoint:
            self.status = "off"
            return {}
        try:
            dt = DevTools(endpoint)
        except (OSError, ConnectionError) as e:
            # The file is stale: the browser was restarted without the flag.
            self.status = "off"
            self.error = str(e)
            return {}
        try:
            targets = dt.call("Target.getTargets").get("targetInfos", [])
            pages = [t for t in targets if t.get("type") in ("page", "app")]
            seen = set()
            for t in pages:
                tid = t["targetId"]
                seen.add(tid)
                cached = self.cache.get(tid)
                url = t.get("url", "")
                stale = (cached is None or cached["url"] != url
                         or not any(p in live_pids for p in cached["pids"]))
                if stale:
                    pids = self._resolve(dt, tid)
                    self.cache[tid] = {"url": url, "title": t.get("title", ""), "pids": pids}
                else:
                    cached["title"] = t.get("title", "")
            for tid in list(self.cache):
                if tid not in seen:
                    del self.cache[tid]
            self.status = "ok"
            self.error = ""
        except (OSError, ConnectionError, RuntimeError, TimeoutError, ValueError) as e:
            self.status = "error"
            self.error = str(e)
        finally:
            dt.close()

        by_host = {}
        for tid, info in self.cache.items():
            host = host_of(info["url"])
            site = by_host.setdefault(host, {"host": host, "targets": [], "pids": set(), "titles": []})
            site["targets"].append(tid)
            site["pids"].update(info["pids"])
            if info["title"]:
                site["titles"].append(info["title"])
        return by_host

    def _resolve(self, dt, target_id):
        pids = []
        session = None
        try:
            session = dt.call("Target.attachToTarget", {"targetId": target_id, "flatten": True})["sessionId"]
            dt.call("Tracing.start", {
                "traceConfig": {"includedCategories": ["disabled-by-default-devtools.timeline"],
                                "recordMode": "recordUntilFull"},
                "transferMode": "ReportEvents",
            }, session=session)
            dt.call("Tracing.end", session=session)
            for m in dt.drain_until("Tracing.tracingComplete"):
                if m.get("method") != "Tracing.dataCollected":
                    continue
                for ev in m.get("params", {}).get("value", []):
                    if ev.get("name") == "TracingStartedInBrowser":
                        for fr in ev.get("args", {}).get("data", {}).get("frames", []):
                            pid = fr.get("processId")
                            if isinstance(pid, int) and pid not in pids:
                                pids.append(pid)
        except (RuntimeError, TimeoutError, ConnectionError):
            pass
        finally:
            if session:
                try:
                    dt.call("Target.detachFromTarget", {"sessionId": session})
                except (RuntimeError, TimeoutError, ConnectionError, OSError):
                    pass
        return pids


def omarchy_webapps():
    """host -> {name, icon}, from the launchers Omarchy writes for web apps."""
    apps = {}
    d = os.path.join(HOME, ".local", "share", "applications")
    try:
        names = os.listdir(d)
    except OSError:
        return apps
    for fn in names:
        if not fn.endswith(".desktop"):
            continue
        txt = read(os.path.join(d, fn), 1 << 14)
        if "omarchy-launch-webapp" not in txt:
            continue
        name = ""
        url = ""
        icon = ""
        for line in txt.splitlines():
            if line.startswith("Name=") and not name:
                name = line[5:].strip()
            elif line.startswith("Icon=") and not icon:
                icon = line[5:].strip()
            elif line.startswith("Exec=") and "omarchy-launch-webapp" in line:
                m = re.search(r"omarchy-launch-webapp\s+\"?(\S+?)\"?(\s|$)", line)
                if m:
                    url = m.group(1)
        if name and url:
            apps[host_of(url)] = {"name": name, "icon": icon}
    return apps


