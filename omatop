# ---------------------------------------------------------------- /proc ----

def read(path, cap=1 << 16):
    """Read a small /proc file. Returns "" on any failure."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except OSError:
        return ""
    try:
        chunks = []
        got = 0
        while got < cap:
            b = os.read(fd, 65536)
            if not b:
                break
            chunks.append(b)
            got += len(b)
        return b"".join(chunks).decode("utf-8", "replace")
    except OSError:
        return ""
    finally:
        os.close(fd)


def meminfo():
    out = {}
    for line in read("/proc/meminfo").splitlines():
        k, _, v = line.partition(":")
        out[k] = int(v.strip().split()[0]) if v.strip() else 0
    total = out.get("MemTotal", 0)
    avail = out.get("MemAvailable", 0)
    return {"total": total, "available": avail, "used": max(0, total - avail),
            "swapTotal": out.get("SwapTotal", 0), "swapUsed": max(0, out.get("SwapTotal", 0) - out.get("SwapFree", 0))}


def loadavg():
    parts = read("/proc/loadavg").split()
    try:
        return [float(parts[0]), float(parts[1]), float(parts[2])]
    except (IndexError, ValueError):
        return [0.0, 0.0, 0.0]


def scan_processes():
    """One pass over /proc for this user's processes."""
    procs = {}
    uptime = uptime_seconds()
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        pid = int(entry)
        base = "/proc/" + entry
        try:
            st = os.stat(base)
        except OSError:
            continue
        if st.st_uid != UID:
            continue
        stat = read(base + "/stat", 4096)
        if not stat:
            continue
        # comm may contain spaces/parens; it is bracketed by the first "(" and last ")".
        lp = stat.find("(")
        rp = stat.rfind(")")
        if lp < 0 or rp < 0:
            continue
        comm = stat[lp + 1:rp]
        fields = stat[rp + 2:].split()
        try:
            ppid = int(fields[1])
            utime = int(fields[11])
            stime = int(fields[12])
            start = int(fields[19])
            rss_pages = int(fields[21])
        except (IndexError, ValueError):
            continue
        procs[pid] = {
            "pid": pid, "ppid": ppid, "comm": comm,
            "cpu": utime + stime,
            "age": max(0, int(uptime - start / CLK_TCK)),
            "rss": rss_pages * 4,  # kB, assuming 4k pages
        }
    return procs


def uptime_seconds():
    try:
        return float(read("/proc/uptime").split()[0])
    except (IndexError, ValueError):
        return 0.0


def pss_kb(pid):
    txt = read("/proc/%d/smaps_rollup" % pid, 8192)
    m = re.search(r"^Pss:\s+(\d+) kB", txt, re.M)
    return int(m.group(1)) if m else None


def cmdline(pid):
    args = [a for a in read("/proc/%d/cmdline" % pid, 1 << 15).split("\0") if a]
    # Chromium rewrites its own argv into one space-joined string.
    if len(args) == 1 and " " in args[0]:
        args = args[0].split(" ")
    return args


def fd_stats(pid):
    """GPU engine time and memory from i915 fdinfo, plus open socket count.

    Every fd is read once; DRM clients are deduped by client id since a
    process usually holds several fds on the same client.
    """
    base = "/proc/%d/fd" % pid
    try:
        fds = os.listdir(base)
    except OSError:
        return None
    gpu_ns = 0
    gpu_mem = 0
    sockets = 0
    clients = set()
    for fd in fds:
        try:
            target = os.readlink(base + "/" + fd)
        except OSError:
            continue
        if target.startswith("socket:["):
            sockets += 1
            continue
        if not target.startswith("/dev/dri/"):
            continue
        info = read("/proc/%d/fdinfo/%s" % (pid, fd), 4096)
        client = ""
        ns = 0
        mem = 0
        for line in info.splitlines():
            if line.startswith("drm-client-id:"):
                client = line.split(":", 1)[1].strip()
            elif line.startswith("drm-engine-render:") or line.startswith("drm-engine-video:") or line.startswith("drm-engine-video-enhance:") or line.startswith("drm-engine-compute:"):
                try:
                    ns += int(line.split(":", 1)[1].strip().split()[0])
                except (ValueError, IndexError):
                    pass
            elif line.startswith("drm-total-system0:") or line.startswith("drm-total-memory:"):
                try:
                    mem += int(line.split(":", 1)[1].strip().split()[0])
                except (ValueError, IndexError):
                    pass
        if client and client in clients:
            continue
        clients.add(client)
        gpu_ns += ns
        gpu_mem += mem
    return {"gpu_ns": gpu_ns, "gpu_mem": gpu_mem, "sockets": sockets}


def io_bytes(pid):
    """Bytes actually read from and written to storage by a process."""
    txt = read("/proc/%d/io" % pid, 1024)
    if not txt:
        return None
    rb = wb = 0
    for line in txt.splitlines():
        if line.startswith("read_bytes:"):
            rb = int(line.split(":", 1)[1].strip() or 0)
        elif line.startswith("write_bytes:"):
            wb = int(line.split(":", 1)[1].strip() or 0)
    return rb + wb


def disk_bytes():
    """Bytes moved by every whole block device (no partitions)."""
    total = 0
    for line in read("/proc/diskstats").splitlines():
        f = line.split()
        if len(f) < 10:
            continue
        name = f[2]
        if name.startswith(("loop", "ram", "zram", "dm-")) or (name[-1].isdigit() and name.startswith(("sd", "vd", "hd"))) or "p" in name[-2:] and name.startswith("nvme"):
            continue
        try:
            total += (int(f[5]) + int(f[9])) * 512
        except ValueError:
            pass
    return total


def net_bytes():
    """Total received and sent bytes over every interface but loopback."""
    rx = tx = 0
    for line in read("/proc/net/dev").splitlines()[2:]:
        name, _, rest = line.partition(":")
        if name.strip() == "lo":
            continue
        f = rest.split()
        if len(f) >= 9:
            try:
                rx += int(f[0])
                tx += int(f[8])
            except ValueError:
                pass
    return rx, tx


def hypr_titles():
    """pid -> window title, from Hyprland. Empty when hyprctl is missing."""
    try:
        import subprocess
        out = subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True, timeout=1.5).stdout
        titles = {}
        for c in json.loads(out or "[]"):
            pid = c.get("pid")
            title = (c.get("title") or "").strip()
            if pid and title and pid not in titles:
                titles[pid] = title
        return titles
    except Exception:
        return {}


# ------------------------------------------------------------- grouping ----

def find_roots(procs):
    """Map every pid to the pid of the app it belongs to."""
    stop = {0, 1}
    for p in procs.values():
        if p["comm"] in STOP_COMMS:
            stop.add(p["pid"])
    root_of = {}

    def root(pid, depth=0):
        if pid in root_of:
            return root_of[pid]
        p = procs.get(pid)
        if p is None:
            return pid
        parent = p["ppid"]
        if parent in stop or parent not in procs or depth > 64:
            root_of[pid] = pid
            return pid
        r = root(parent, depth + 1)
        root_of[pid] = r
        return r

    for pid in procs:
        root(pid)
    return root_of


