class Sampler:
    def __init__(self):
        self.prev = {}       # pid -> (cpu ticks, monotonic time)
        self.resolvers = {}  # profile dir -> SiteResolver
        self.favicons = {}   # profile dir -> FaviconStore
        self.pss_budget = 32
        self.order = []      # row keys in last-published order, for stable sorting
        self.prev_gpu = {}   # pid -> (gpu ns, monotonic time)
        self.prev_net = None # (rx, tx, monotonic time)
        self.prev_io = {}    # pid -> (bytes, monotonic time)
        self.prev_disk = None
        self.tick = 0
        self.gpu_pct = {}
        self.gpu_mem = {}
        self.sockets = {}
        self.webapps = omarchy_webapps()
        self.webapps_read = time.monotonic()

    def net_rate(self):
        now = time.monotonic()
        rx, tx = net_bytes()
        rate = {"down": 0, "up": 0}
        if self.prev_net is not None:
            dt = now - self.prev_net[2]
            if dt > 0:
                rate = {"down": max(0, int((rx - self.prev_net[0]) / dt)), "up": max(0, int((tx - self.prev_net[1]) / dt))}
        self.prev_net = (rx, tx, now)
        return rate

    def disk_rate(self):
        now = time.monotonic()
        total = disk_bytes()
        rate = 0
        if self.prev_disk is not None:
            dt = now - self.prev_disk[1]
            if dt > 0:
                rate = max(0, int((total - self.prev_disk[0]) / dt))
        self.prev_disk = (total, now)
        return rate

    def light(self):
        return {"ts": time.time(), "light": True, "mem": meminfo(), "load": loadavg(), "ncpu": NCPU, "net": self.net_rate()}

    def full(self):
        now = time.monotonic()
        procs = scan_processes()
        root_of = find_roots(procs)

        # CPU% per pid from tick deltas; first sample has no history.
        cpu_pct = {}
        for pid, p in procs.items():
            prev = self.prev.get(pid)
            if prev is not None:
                dt = now - prev[1]
                if dt > 0:
                    cpu_pct[pid] = max(0.0, (p["cpu"] - prev[0]) / CLK_TCK / dt * 100.0)
        self.prev = {pid: (p["cpu"], now) for pid, p in procs.items()}

        # PSS for the heaviest processes (shared pages counted once); RSS
        # for the long tail, where the difference does not change the answer.
        mem = {pid: p["rss"] for pid, p in procs.items()}
        for pid in sorted(procs, key=lambda x: procs[x]["rss"], reverse=True)[: self.pss_budget]:
            if procs[pid]["rss"] < 24 * 1024:
                break
            v = pss_kb(pid)
            if v is not None:
                mem[pid] = v

        # GPU time, GPU memory and sockets for the processes that matter:
        # the fd walk is the costly part, so it stops at the sixty heaviest.
        # The fd walk is the costly part of a sample, so it runs every other
        # tick and the tick between reuses its numbers.
        self.tick += 1
        walk = self.tick % 2 == 1
        gpu_pct = dict(self.gpu_pct)
        gpu_mem = dict(self.gpu_mem)
        sockets = dict(self.sockets)
        disk_rate = {}
        for pid in sorted(procs, key=lambda x: procs[x]["rss"], reverse=True)[:60]:
            b = io_bytes(pid)
            if b is not None:
                prev = self.prev_io.get(pid)
                if prev is not None and now > prev[1]:
                    disk_rate[pid] = max(0, (b - prev[0]) / (now - prev[1]))
                self.prev_io[pid] = (b, now)
            if not walk:
                continue
            st = fd_stats(pid)
            if st is None:
                continue
            sockets[pid] = st["sockets"]
            gpu_mem[pid] = st["gpu_mem"]
            prev = self.prev_gpu.get(pid)
            if prev is not None:
                dt = now - prev[1]
                if dt > 0:
                    gpu_pct[pid] = max(0.0, min(100.0, (st["gpu_ns"] - prev[0]) / 1e9 / dt * 100.0))
            self.prev_gpu[pid] = (st["gpu_ns"], now)
        for pid in list(self.prev_gpu):
            if pid not in procs:
                del self.prev_gpu[pid]
        for pid in list(self.prev_io):
            if pid not in procs:
                del self.prev_io[pid]
        for d in (gpu_pct, gpu_mem, sockets):
            for pid in list(d):
                if pid not in procs:
                    del d[pid]
        self.gpu_pct = gpu_pct
        self.gpu_mem = gpu_mem
        self.sockets = sockets
        self.disk_per_pid = disk_rate
        net = self.net_rate()
        disk = self.disk_rate()

        titles = hypr_titles()

        groups = {}
        for pid, p in procs.items():
            r = root_of[pid]
            g = groups.setdefault(r, {"root": r, "pids": []})
            g["pids"].append(pid)

        apps = []
        for r, g in groups.items():
            rp = procs.get(r)
            if rp is None or rp["comm"] in HIDDEN_COMMS:
                continue
            pids = g["pids"]
            comm = rp["comm"]
            # A launcher script or login shell at the root says nothing
            # about what is running; name the group after its heaviest member.
            if is_wrapper(comm) and len(pids) > 1:
                comm = procs[max(pids, key=lambda p: mem[p])]["comm"]
            comms = {procs[p]["comm"] for p in pids}
            title = ""
            for p in pids:
                if p in titles:
                    title = titles[p]
                    break
            app = {
                "key": "app:%d" % r,
                "root": r,
                "comm": comm,
                "name": pretty_name(comm),
                "title": title,
                "pids": pids,
                "count": len(pids),
                "mem": sum(mem[p] for p in pids),
                "cpu": round(sum(cpu_pct.get(p, 0.0) for p in pids), 1),
                "gpu": round(sum(gpu_pct.get(p, 0.0) for p in pids), 1),
                "gpuMem": sum(gpu_mem.get(p, 0) for p in pids),
                "net": sum(sockets.get(p, 0) for p in pids),
                "disk": int(sum(disk_rate.get(p, 0.0) for p in pids)),
                "age": rp["age"],
                "protected": bool(comms & PROTECTED_COMMS),
                "browser": comm in BROWSER_COMMS,
            }
            if app["browser"]:
                self._attach_sites(app, procs, mem, cpu_pct, titles)
            apps.append(app)

        # Heaviest first, but not twitchy: rows keep their place until they
        # differ by a whole 48 MB step, so a list under the cursor holds still.
        apps = self.stable_sort(apps)
        for app in apps:
            if "sites" in app:
                app["sites"] = self.stable_sort(app["sites"])
        return {"ts": time.time(), "light": False, "mem": meminfo(), "load": loadavg(), "ncpu": NCPU,
                "gpu": round(min(100.0, sum(gpu_pct.values())), 1), "net": net, "disk": disk, "apps": apps}

    def stable_sort(self, rows):
        rank = {key: i for i, key in enumerate(self.order)}
        rows.sort(key=lambda r: rank.get(r["key"], len(rank)))
        rows.sort(key=lambda r: -(r["mem"] // (48 * 1024)))
        seen = set()
        kept = [k for k in self.order if not (k in seen or seen.add(k))]
        for r in rows:
            if r["key"] not in seen:
                kept.append(r["key"])
                seen.add(r["key"])
        # Re-rank everything that was published this tick in its new order.
        published = [r["key"] for r in rows]
        self.order = published + [k for k in kept if k not in set(published)]
        return rows

    def _attach_sites(self, app, procs, mem, cpu_pct, titles):
        cmds = {pid: cmdline(pid) for pid in app["pids"]}
        kinds = {pid: chromium_kind(cmds[pid]) for pid in app["pids"]}
        profile = browser_profile_dir(cmds.get(app["root"], []))
        resolver = self.resolvers.get(profile)
        if resolver is None:
            resolver = self.resolvers[profile] = SiteResolver(profile)
        renderers = {pid for pid, k in kinds.items() if k == "renderer"}
        by_host = resolver.sites(renderers)
        favicons = self.favicons.get(profile)
        if favicons is None:
            favicons = self.favicons[profile] = FaviconStore(profile)

        if time.monotonic() - self.webapps_read > 60:
            self.webapps = omarchy_webapps()
            self.webapps_read = time.monotonic()

        rows = []
        claimed = set()
        for host, site in by_host.items():
            pids = sorted(p for p in site["pids"] if p in renderers)
            claimed.update(pids)
            webapp = self.webapps.get(host)
            app_name = webapp["name"] if webapp else ""
            urls = [resolver.cache[t]["url"] for t in site["targets"] if t in resolver.cache]
            rows.append({
                "key": "site:%s" % host,
                "kind": "site",
                "name": host,
                "app": app_name,
                "omarchy": bool(app_name),
                "iconName": webapp["icon"] if webapp else "",
                "icon": favicons.icon_for(host, urls),
                "title": site["titles"][0] if site["titles"] else "",
                "tabs": len(site["targets"]),
                "targets": site["targets"],
                "pids": pids,
                "mem": sum(mem[p] for p in pids),
                "cpu": round(sum(cpu_pct.get(p, 0.0) for p in pids), 1),
                "gpu": round(sum(self.gpu_pct.get(p, 0.0) for p in pids), 1),
                "net": sum(self.sockets.get(p, 0) for p in pids),
                "disk": int(sum(self.disk_per_pid.get(p, 0.0) for p in pids)),
                "age": max([procs[p]["age"] for p in pids] or [0]),
                "closable": True,
            })

        def bucket(key, name, members, note=""):
            if not members:
                return
            rows.append({
                "key": key, "kind": "bucket", "name": name, "title": note, "tabs": 0, "targets": [],
                "pids": sorted(members),
                "mem": sum(mem[p] for p in members),
                "cpu": round(sum(cpu_pct.get(p, 0.0) for p in members), 1),
                "gpu": round(sum(self.gpu_pct.get(p, 0.0) for p in members), 1),
                "net": sum(self.sockets.get(p, 0) for p in members),
                "disk": int(sum(self.disk_per_pid.get(p, 0.0) for p in members)),
                "closable": False,
            })

        bucket("bucket:extensions", "Extensions", [p for p, k in kinds.items() if k == "extension"])
        bucket("bucket:background", "Background pages", [p for p in renderers if p not in claimed],
               "prerender, service workers, tabs mid-close")
        bucket("bucket:core", "Browser core", [p for p, k in kinds.items() if k not in ("renderer", "extension")],
               "UI, GPU, network")

        app["sites"] = rows
        app["devtools"] = resolver.status
        if resolver.error:
            app["devtoolsError"] = resolver.error[:200]
        app["profile"] = profile


def cmd_watch(args):
    interval = 2.0
    light = False
    i = 0
    while i < len(args):
        if args[i] == "--interval" and i + 1 < len(args):
            interval = max(0.5, float(args[i + 1]))
            i += 2
        elif args[i] == "--light":
            light = True
            i += 1
        elif args[i] == "--once":
            interval = 0
            i += 1
        else:
            i += 1

    sampler = Sampler()
    out = sys.stdout
    while True:
        started = time.monotonic()
        snap = sampler.light() if light else sampler.full()
        try:
            out.write(json.dumps(snap, separators=(",", ":")) + "\n")
            out.flush()
        except BrokenPipeError:
            return 0
        if interval == 0:
            # --once still needs two samples for rates; take the second quickly.
            if snap.get("cpuSampled"):
                return 0
            time.sleep(0.6)
            snap = sampler.light() if light else sampler.full()
            snap["cpuSampled"] = True
            out.write(json.dumps(snap, separators=(",", ":")) + "\n")
            out.flush()
            return 0
        time.sleep(max(0.2, interval - (time.monotonic() - started)))


def cmd_close_site(args):
    targets = []
    profile = os.path.join(HOME, ".config", "chromium")
    i = 0
    while i < len(args):
        if args[i] == "--targets" and i + 1 < len(args):
            targets = [t for t in args[i + 1].split(",") if t]
            i += 2
        elif args[i] == "--profile" and i + 1 < len(args):
            profile = args[i + 1]
            i += 2
        else:
            i += 1
    endpoint = read_devtools_endpoint(profile)
    if not endpoint:
        print("devtools endpoint not available", file=sys.stderr)
        return 2
    dt = DevTools(endpoint)
    failed = 0
    try:
        for t in targets:
            try:
                dt.call("Target.closeTarget", {"targetId": t})
            except (RuntimeError, TimeoutError) as e:
                failed += 1
                print("close %s: %s" % (t, e), file=sys.stderr)
    finally:
        dt.close()
    return 1 if failed else 0


def hypr_clients():
    try:
        out = subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True, timeout=1.5).stdout
        return json.loads(out or "[]")
    except (OSError, ValueError, subprocess.SubprocessError):
        return []


def hypr_focus(address):
    """Focus a window by address. Omarchy's Hyprland speaks Lua on the
    dispatch socket, so that form goes first; the classic form is the
    fallback for a stock Hyprland."""
    lua = 'hl.dsp.focus({ window = "address:%s" })' % address
    out = subprocess.run(["hyprctl", "dispatch", lua], capture_output=True, text=True, timeout=1.5)
    if "error" in (out.stdout + out.stderr).lower():
        subprocess.run(["hyprctl", "dispatch", "focuswindow", "address:%s" % address],
                       capture_output=True, timeout=1.5)


def cmd_activate_site(args):
    target = ""
    profile = os.path.join(HOME, ".config", "chromium")
    i = 0
    while i < len(args):
        if args[i] == "--target" and i + 1 < len(args):
            target = args[i + 1]
            i += 2
        elif args[i] == "--profile" and i + 1 < len(args):
            profile = args[i + 1]
            i += 2
        else:
            i += 1
    endpoint = read_devtools_endpoint(profile)
    if not endpoint or not target:
        return 2
    dt = DevTools(endpoint)
    title = ""
    try:
        for t in dt.call("Target.getTargets").get("targetInfos", []):
            if t.get("targetId") == target:
                title = t.get("title", "")
        dt.call("Target.activateTarget", {"targetId": target})
    except (RuntimeError, TimeoutError, ConnectionError):
        return 1
    finally:
        dt.close()
    # The tab is now in front inside its window; bring that window to front.
    # Chromium titles its windows "<tab title> - Chromium", web-app windows
    # just "<tab title>", so a prefix match finds either.
    time.sleep(0.15)
    chosen = None
    for c in hypr_clients():
        ct = c.get("title") or ""
        if title and ct.startswith(title):
            chosen = c
            break
    if chosen is None:
        for c in hypr_clients():
            if (c.get("class") or "").lower() in ("chromium", "chromium-browser", "google-chrome", "brave-browser", "helium"):
                chosen = c
                break
    if chosen is not None:
        hypr_focus(chosen.get("address"))
    return 0


def cmd_focus_app(args):
    pids = set()
    i = 0
    while i < len(args):
        if args[i] == "--pids" and i + 1 < len(args):
            pids = {int(p) for p in args[i + 1].split(",") if p.strip().isdigit()}
            i += 2
        else:
            i += 1
    for c in hypr_clients():
        if c.get("pid") in pids and c.get("mapped", True):
            hypr_focus(c.get("address"))
            return 0
    return 3


def cmd_kill(args):
    pids = []
    force = False
    i = 0
    while i < len(args):
        if args[i] == "--pids" and i + 1 < len(args):
            pids = [int(p) for p in args[i + 1].split(",") if p.strip().isdigit()]
            i += 2
        elif args[i] == "--force":
            force = True
            i += 1
        else:
            i += 1
    me = os.getpid()
    sig = signal.SIGKILL if force else signal.SIGTERM
    failed = 0
    for pid in pids:
        if pid in (me, os.getppid(), 1):
            continue
        try:
            if os.stat("/proc/%d" % pid).st_uid != UID:
                continue
            os.kill(pid, sig)
        except ProcessLookupError:
            pass
        except (OSError, PermissionError) as e:
            failed += 1
            print("kill %d: %s" % (pid, e), file=sys.stderr)
    return 1 if failed else 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    cmd, rest = argv[0], argv[1:]
    if cmd == "watch":
        return cmd_watch(rest)
    if cmd == "close-site":
        return cmd_close_site(rest)
    if cmd == "activate-site":
        return cmd_activate_site(rest)
    if cmd == "focus-app":
        return cmd_focus_app(rest)
    if cmd == "kill":
        return cmd_kill(rest)
    print("unknown command: %s" % cmd, file=sys.stderr)
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
