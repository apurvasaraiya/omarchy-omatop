ICON_DIR = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "omatop-%d" % UID, "icons")


class FaviconStore:
    """Site icons out of Chromium's own favicon database.

    The database is locked while the browser runs, so a copy is taken (a
    few MB, at most every five minutes) and queried read-only. Icons land
    as PNG files under the runtime dir, one per host, for the panel to show.
    """

    def __init__(self, profile_dir):
        self.profile_dir = profile_dir
        self.cache = {}
        self.copy = None
        self.copied_at = 0.0

    def icon_for(self, host, urls):
        if host in self.cache:
            return self.cache[host]
        path = ""
        try:
            path = self._extract(host, urls)
        except (OSError, sqlite3.Error):
            path = ""
        self.cache[host] = path
        return path

    def _database(self):
        src = os.path.join(self.profile_dir, "Default", "Favicons")
        if not os.path.isfile(src):
            return None
        if self.copy is None or time.monotonic() - self.copied_at > 300:
            os.makedirs(ICON_DIR, 0o700, exist_ok=True)
            dst = os.path.join(ICON_DIR, "favicons.%d.sqlite" % os.getpid())
            shutil.copyfile(src, dst)
            self.copy = dst
            self.copied_at = time.monotonic()
            self.cache = {}
            atexit.register(lambda: _quiet_remove(dst))
        return self.copy

    def _extract(self, host, urls):
        db = self._database()
        if not db:
            return ""
        out = os.path.join(ICON_DIR, "%s.png" % re.sub(r"[^A-Za-z0-9.-]", "_", host))
        conn = sqlite3.connect("file:%s?mode=ro" % db, uri=True)
        try:
            patterns = list(urls) + ["https://%s/%%" % host, "https://www.%s/%%" % host, "http://%s/%%" % host]
            for pattern in patterns:
                rows = conn.execute(
                    "select fb.image_data, fb.width from icon_mapping im "
                    "join favicon_bitmaps fb on fb.icon_id = im.icon_id "
                    "where im.page_url like ? order by fb.width desc limit 6", (pattern,)).fetchall()
                if not rows:
                    continue
                small = [r for r in rows if r[1] and r[1] <= 64]
                data = (small[0] if small else rows[-1])[0]
                if not data:
                    continue
                # Exclusive temp under an unguessable name, then rename: the
                # final path is only ever a rename target, never opened.
                tmp = "%s.%d.%s.tmp" % (out, os.getpid(), base64.b32encode(os.urandom(5)).decode().lower())
                fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
                try:
                    os.write(fd, data)
                finally:
                    os.close(fd)
                os.replace(tmp, out)
                return out
        finally:
            conn.close()
        return ""


def _quiet_remove(path):
    try:
        os.remove(path)
    except OSError:
        pass


def browser_profile_dir(root_cmd):
    for arg in root_cmd:
        if arg.startswith("--user-data-dir="):
            return os.path.expanduser(arg.split("=", 1)[1])
    return os.path.join(HOME, ".config", "chromium")


def chromium_kind(cmd):
    """Classify a Chromium child by its --type flag."""
    typ = ""
    ext = False
    for arg in cmd:
        if arg.startswith("--type="):
            typ = arg[7:]
        elif arg == "--extension-process":
            ext = True
    if typ == "renderer":
        return "extension" if ext else "renderer"
    if typ == "":
        return "browser"
    return typ


